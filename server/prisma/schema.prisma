generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  uploading
  submitted
  under_review
  approved
  rejected
  payment_submitted
  payment_approved
  payment_rejected
  certificate_issued
}

enum PaymentStatus {
  pending
  submitted
  approved
  rejected
}

enum DonationStatus {
  pending
  verified
  rejected
}

model Application {
  id        String            @id @default(uuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  status    ApplicationStatus @default(submitted)

  authUserId String? @unique
  authEmail  String?

  fullName      String
  dob           String?
  gender        String?
  mobile        String
  email         String
  address       String?
  district      String?
  institution   String?
  qualification String?

  fatherName        String?
  fatherOccupation  String?
  fatherContact     String?
  motherName        String?
  motherOccupation  String?
  motherContact     String?
  guardianName      String?
  guardianRelation  String?
  guardianContact   String?
  parentStatus      String?

  bothParentsDeceased  String?
  fatherDeathCertUrl   String?
  motherDeathCertUrl   String?
  singleParent         String?
  supportingParent     String?
  supportingDocumentUrl String?

  annualIncome         String?
  incomeCertificateUrl String?
  expenseBearer        String?
  selfEarning          String?
  employmentType       String?
  monthlyIncome        String?
  selfIncomeDocUrl     String?
  supportsDependents   String?
  numDependents        String?

  socialCategory          String?
  communityCertificateUrl String?
  existingScholarship     String?
  scholarshipName         String?
  scholarshipProvider     String?
  scholarshipAmount       String?
  scholarshipYear         String?
  scholarshipDocUrl       String?

  tenth                 Json?
  twelfth               Json?
  college               Json?
  govtSchoolEvidenceUrl String?

  hasDiploma            String?
  diplomaPercentage     String?
  diplomaMarkSheetUrl   String?
  latestAcademicPercentage String?

  medium                String?
  tamilMediumTill12     String?
  tamilMediumEvidenceUrl String?

  examCategory          String?
  examName              String?
  examYear              String?
  targetAttempt         String?
  relevantQualification String?
  coachingMode          String?

  studentPhotoUrl            String?
  identityDocumentUrl        String?
  educationalCertificatesUrl String?

  declarationAccepted Boolean @default(false)

  documentReviews Json?

  calculatedConcession       Int?
  concessionCategory         String?
  finalApprovedConcession    Int?
  concessionNote             String?
  concessionDecidedAt        DateTime?
  concessionApprovedByEmail  String?

  courseFee Int?

  payment     Payment?
  certificate Certificate?

  @@map("applications")
}

model Payment {
  id            String        @id @default(uuid())
  applicationId String        @unique
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        PaymentStatus @default(pending)

  amountDue        Int?
  amountPaid       Int?
  paymentMethod    String?
  transactionId    String?
  paymentDate      DateTime?
  paymentProofPath String?

  submittedAt     DateTime?
  verifiedByEmail String?
  verifiedAt      DateTime?
  rejectionReason String?
  adminRemarks    String?

  receiptNumber String? @unique
  receiptPath   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Certificate {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  certificateNumber    String  @unique
  certificateType      String  @default("Scholarship Concession")
  studentName          String
  courseName           String?
  concessionPercentage Int

  certificatePath String?
  issuedByEmail   String?
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@map("certificates")
}

model Donation {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  status    DonationStatus @default(pending)

  fullName       String
  email          String
  mobile         String
  amount         Int
  purpose        String
  pan            String?
  transactionRef String

  verifiedByEmail String?
  verifiedAt      DateTime?
  rejectionReason String?

  receiptNumber      String?   @unique
  receiptPath        String?
  receiptEmailSentAt DateTime?

  @@map("donations")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model AuditLog {
  id            String   @id @default(uuid())
  adminEmail    String?
  applicationId String?
  paymentId     String?
  action        String
  oldStatus     String?
  newStatus     String?
  oldValue      Json?
  newValue      Json?
  remarks       String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}

enum ExpensePaymentMode {
  cash
  upi
  bank_transfer
  cheque
  card
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String   @unique
  icon      String   @default("other")
  sortOrder Int      @default(0)

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId  String
  category    ExpenseCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String
  amount      Int
  date        DateTime           @db.Date
  paymentMode ExpensePaymentMode
  paidTo      String?
  referenceNo String?
  notes       String?

  billPath     String?
  billFileName String?

  createdByEmail String?
  updatedByEmail String?

  @@index([date])
  @@index([categoryId])
  @@map("expenses")
}


enum StaffWorkLogStatus {
  pending
  approved
  rejected
}

model Staff {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffCode          String    @unique
  name               String
  phone              String?
  email              String?
  hourlyRate         Int
  active             Boolean   @default(true)
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  sessionVersion     Int       @default(0)
  lastLoginAt        DateTime?
  createdByEmail     String?

  dob               String?
  gender            String?
  address           String?
  qualification     String?
  degree            String?
  institution       String?
  passingYear       Int?
  experienceYears   Int?
  subjects          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  pan               String?

  documents StaffDocument[]
  workLogs  StaffWorkLog[]
  payouts   StaffPayout[]

  @@map("staff")
}

model StaffDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind      String
  path      String
  fileName  String
  mimeType  String

  @@index([staffId])
  @@map("staff_documents")
}

model StaffWorkLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffId     String
  staff       Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime           @db.Date
  minutes     Int
  description String
  status      StaffWorkLogStatus @default(pending)

  hourlyRate      Int?
  amount          Int?
  reviewedByEmail String?
  reviewedAt      DateTime?
  rejectionReason String?

  payoutId String?
  payout   StaffPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([staffId, date])
  @@index([status])
  @@map("staff_work_logs")
}

model StaffPayout {
  id             String             @id @default(uuid())
  createdAt      DateTime           @default(now())
  staffId        String
  staff          Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month          String
  minutes        Int
  amount         Int
  paidOn         DateTime           @db.Date
  paymentMode    ExpensePaymentMode
  referenceNo    String?
  expenseId      String?
  createdByEmail String?

  workLogs StaffWorkLog[]

  @@index([staffId])
  @@map("staff_payouts")
}
