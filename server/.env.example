# Supabase Postgres connection.
# Project settings -> Database -> Connection string.
# DATABASE_URL: pooled connection (port 6543, pgbouncer) — used at runtime by the app.
# DIRECT_URL: direct connection (port 5432) — used by Prisma for migrations.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.wignfyougscvoungjzwj.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.wignfyougscvoungjzwj.supabase.co:5432/postgres"

PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Admin portal — change both before deploying anywhere real.
ADMIN_PASSWORD="change-me"
JWT_SECRET="replace-with-a-long-random-string"
# Email attached to the auto-provisioned admin identity used for approvals /
# the audit trail (see getOrCreateAdminIdentity in src/auth.js). Not a secret —
# defaults to admin@ngcollege.trust if unset. Only one admin identity exists
# today; this is not a login field, the shared ADMIN_PASSWORD above still is.
ADMIN_EMAIL="admin@ngcollege.trust"

# Supabase Storage — server-only, never exposed to the browser.
# Project Settings -> API -> Project URL / service_role secret.
# The service_role key bypasses Row Level Security entirely — keep it out of
# any client bundle and out of chat; paste it directly into .env.
SUPABASE_URL="https://wignfyougscvoungjzwj.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="paste-the-service-role-secret-here"
SUPABASE_STORAGE_BUCKET="documents"

# Resend (https://resend.com) — sends the donation receipt PDF to the donor
# once an admin verifies their donation. RESEND_FROM_EMAIL must be an address
# on a domain verified in the Resend dashboard, or the shared onboarding@resend.dev
# sender (works without domain verification, fine for testing).
RESEND_API_KEY="paste-your-resend-api-key-here"
RESEND_FROM_EMAIL="NextGen Solutions Educational Trust <onboarding@resend.dev>"
